# Application timezone (IANA). All due dates and timestamps use this zone.
# APP_TIMEZONE=Africa/Johannesburg

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production
SESSION_SECRET_KEY=your-session-secret-key-here

# Database Configuration
# Default is SQLite: app/edumind_ai.db (auto-created).
#
# For a 3-tier setup (DB on different machine), use a remote Postgres URL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# DATABASE_URL=
#
# Optional override for SQLite file path:
# SQLITE_DB_PATH=/app/data/edumind_ai.db

# --------- AI (pick one or both; Ollama wins when OLLAMA_BASE_URL is non-empty) ---------

# Cloud: OpenRouter — https://openrouter.ai/ (optional if you use Ollama locally)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Local free AI: Ollama — https://ollama.com
# 1) Install Ollama for Windows/Mac/Linux
# 2) In a terminal:  ollama pull llama3.2   (or another model)
# 3) Ollama runs in the background on http://127.0.0.1:11434 by default
#
# Development (FLASK_ENV=development): you can OMIT these lines — the app defaults to
# OLLAMA_BASE_URL=http://127.0.0.1:11434 automatically.
#
# To disable Ollama in dev (e.g. OpenRouter only), set explicitly:
# OLLAMA_BASE_URL=
#
# Production / remote Ollama tunnel: set full URL
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# Email Configuration (for password reset and email verification)
# Recommended (no Gmail): use a transactional email API (Resend)
# If RESEND_API_KEY is set, the app will send verification/OTP emails via API.
# RESEND_FROM must be a verified sender/domain in your provider dashboard.
# RESEND_API_KEY=
# RESEND_FROM="EduMind <noreply@yourdomain.com>"

# SMTP fallback (optional)
# For Gmail: use smtp.gmail.com, port 587, TLS enabled (requires Google app password)
# For other providers: check your provider's SMTP settings
# ---- Outlook / Microsoft 365 SMTP example ----
# MAIL_SERVER=smtp.office365.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USE_SSL=false
# MAIL_USERNAME=youraddress@outlook.com
# MAIL_PASSWORD=your-app-password-or-smtp-password
# MAIL_DEFAULT_SENDER="EduMind <youraddress@outlook.com>"
#
# ---- Gmail SMTP example ----
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER="EduMind <your-email@gmail.com>"
